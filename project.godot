; Engine configuration file.
; Creature RPG 2D Engine — Godot 4 project.
; Regenerated/edited safely by the Godot editor.

config_version=5

[application]

config/name="Creature RPG 2D Engine"
config/description="Original, offline, data-driven creature-capture RPG. No third-party IP."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://assets/placeholder_ui/icon.svg"

[autoload]

SettingsManager="*res://scripts/autoload/settings_manager.gd"
DataRegistry="*res://scripts/autoload/data_registry.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
AdaptiveDirector="*res://scripts/autoload/adaptive_director.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

