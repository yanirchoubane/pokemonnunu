{
  "$schema_version": 1,
  "description": "AdaptiveDirector policy. All bounds are hard limits; scaling is smoothed and never touches the player's own stats.",
  "skill_score": {
    "initial": 50.0,
    "min": 0.0,
    "max": 100.0,
    "smoothing": 0.25,
    "min_battles_before_adapt": 3,
    "weights": {
      "win": 6.0,
      "loss": -8.0,
      "flawless_win": 3.0,
      "item_heavy_penalty": -2.0,
      "type_advantage_usage": 2.0,
      "level_underdog_bonus": 4.0
    }
  },
  "difficulty_modes": {
    "relaxed":  { "enemy_level_delta": -2, "ai_tier_cap": "basic",        "adapt": false, "reward_multiplier": 1.25 },
    "normal":   { "enemy_level_delta": 0,  "ai_tier_cap": "advanced",     "adapt": false, "reward_multiplier": 1.0 },
    "hard":     { "enemy_level_delta": 2,  "ai_tier_cap": "advanced",     "adapt": false, "reward_multiplier": 0.9 },
    "adaptive": { "enemy_level_delta": 0,  "ai_tier_cap": "advanced",     "adapt": true,  "reward_multiplier": 1.0 }
  },
  "scaling_bounds": {
    "enemy_level_delta_min": -3,
    "enemy_level_delta_max": 3,
    "per_battle_delta_step_max": 1,
    "ai_upgrade_skill_threshold": 65.0,
    "ai_downgrade_skill_threshold": 35.0,
    "reward_multiplier_min": 0.75,
    "reward_multiplier_max": 1.3,
    "encounter_rate_min": 0.5,
    "encounter_rate_max": 1.5
  },
  "boss_policy": {
    "scaling": "limited",
    "max_level_delta": 1,
    "lock_ai_tier": true
  },
  "intensity": { "default": 0.5, "min": 0.0, "max": 1.0 }
}
